{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["../../AGENTS.md", "../agents/rules/AGENTS.md"],
  "default_agent": "homelab",
  "agent": {
    "homelab": {
      "model": "opencode-go/kimi-k2.7-code",
      "description": "Main entry point for homelab operations. Orchestrates context gathering, planning, and delegates implementation to native agents.",
      "mode": "primary",
      "prompt": "{file:../agents/homelab.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "question": "allow",
        "external_directory": "allow",
        "task": {
          "general": "allow",
          "explore": "allow",
          "scout": "allow"
        },
        "bash": {
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git checkout -b *": "allow",
          "git switch -c *": "allow",
          "git add *": "allow",
          "git commit -m *": "allow",
          "git push -u origin feat/*": "allow",
          "git push -u origin fix/*": "allow",
          "git push -u origin chore/*": "allow",
          "gh pr create --draft *": "allow"
        }
      }
    },
    "dependency-reviewer": {
      "model": "opencode-go/kimi-k2.7-code",
      "description": "Reviews Renovate dependency update PRs. Uses native explore for local context and web tools for external research.",
      "mode": "primary",
      "prompt": "{file:../agents/dependency-reviewer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "task": {
          "explore": "allow",
          "scout": "allow",
          "general": "allow"
        },
        "bash": {
          "gh pr comment": "allow",
          "gh pr comment *": "allow",
          "gh search *": "allow"
        }
      }
    },
    "general": {
      "model": "litellm/unsloth/qwen-3.6",
      "mode": "subagent"
    },
    "explore": {
      "model": "litellm/unsloth/qwen-3.6",
      "mode": "subagent"
    },
    "scout": {
      "model": "litellm/unsloth/qwen-3.6",
      "mode": "subagent"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },
  "provider": {
      "litellm": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "LiteLLM",
        "options": {
          "baseURL": "https://litellm.homelab.leehosanganson.dev",
          "apiKey": "{env:LITELLM_KEY}",
          "timeout": 600000,
          "chunkTimeout": 60000,
          "setCacheKey": true
        },
        "models": {
          "unsloth/qwen-3.6": { "limit": { "context": 100000, "output": 16384 } },
          "gemini/gemini-2.5-flash-lite": {},
          "gemini/gemini-3.1-pro": {},
          "openrouter/openrouter/free": {},
          "gemini/gemini-3.1-flash-preview": {},
          "gemini/gemini-3-flash-preview": {}
        }
      },
      "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  }
}
