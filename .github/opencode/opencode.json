{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["../../AGENTS.md", "../agents/rules/AGENTS.md"],
  "default_agent": "homelab",
  "agent": {
    "homelab": {
      "description": "Main entry point for homelab operations. Orchestrates context gathering, planning, and delegates implementation to native agents.",
      "mode": "primary",
      "prompt": "{file:../agents/homelab.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "dispatcher": "allow",
          "explore": "allow"
        },
        "bash": {
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git checkout -b *": "allow",
          "git switch -c *": "allow",
          "git add *": "allow",
          "git commit -m *": "allow",
          "git push -u origin feat/*": "allow",
          "git push -u origin fix/*": "allow",
          "git push -u origin chore/*": "allow",
          "gh pr create --draft *": "allow"
        }
      }
    },
    "dependency-reviewer": {
      "description": "Reviews Renovate dependency update PRs. Uses native explore for local context and web tools for external research.",
      "mode": "primary",
      "prompt": "{file:../agents/dependency-reviewer.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "explore": "allow",
          "dispatcher": "allow"
        },
        "bash": {
          "gh pr comment": "allow",
          "gh pr comment *": "allow",
          "gh search *": "allow"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.homelab.leehosanganson.dev",
        "apiKey": "{file:~/.config/sops-nix/secrets/litellm-api-key}",
        "timeout": 600000,
        "chunkTimeout": 60000,
        "setCacheKey": true
      },
      "models": {
        "unsloth/qwen-3.6": { "limit": { "context": 100000, "output": 16384 } },
        "gemini/gemini-2.5-flash-lite": {},
        "gemini/gemini-3.1-pro": {},
        "openrouter/openrouter/free": {},
        "gemini/gemini-3.1-flash-lite-preview": {},
        "gemini/gemini-3-flash-preview": {}
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{file:~/.config/sops-nix/secrets/opencode-api-key}"
      }
    }
  }
}
